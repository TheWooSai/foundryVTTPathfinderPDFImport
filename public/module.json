{
  "id": "foundry-pathfinder-pdf-import",
  "title": "Pathfinder PDF Importer",
  "description": "Imports Pathfinder 2e adventures from PDFs you own. Rebuilt for Foundry v14 from the MIT-licensed pdftofoundry 5.0.0 by Kevin Hjelden.",
  "version": "6.0.0",
  "authors": [
    {
      "name": "TheWooSai"
    },
    {
      "name": "Kevin Hjelden (original pdftofoundry)"
    }
  ],
  "esmodules": [
    "main.js"
  ],
  "styles": [
    "styles.css"
  ],
  "flags": {
    "compendiumArtMappings": {
      "pf2e": {
        "mapping": "pathfinder-pdf-import-image-mapping.json"
      }
    }
  },
  "compatibility": {
    "minimum": "14.359",
    "verified": "14.365",
    "maximum": "14"
  },
  "relationships": {
    "systems": [
      {
        "id": "pf2e",
        "type": "system",
        "compatibility": {
          "minimum": "8.3.0",
          "verified": "8.3.0"
        }
      }
    ]
  },
  "url": "https://github.com/TheWooSai/foundryVTTPathfinderPDFImport",
  "bugs": "https://github.com/TheWooSai/foundryVTTPathfinderPDFImport/issues",
  "manifest": "https://github.com/TheWooSai/foundryVTTPathfinderPDFImport/releases/latest/download/module.json",
  "download": "https://github.com/TheWooSai/foundryVTTPathfinderPDFImport/releases/latest/download/module.zip"
}
